---
import '../styles/globals.css';
import FloatingShapes from '../components/FloatingShapes.jsx';
import Footer from '../components/Footer.jsx';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/dev.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!--
      Script de tema: se ejecuta de forma síncrona ANTES de pintar la página.
      Esto evita el "flash" (parpadeo blanco → oscuro o viceversa) al cargar.
      Lee localStorage y aplica la clase "light" al <html> si el usuario
      eligió el tema claro en una visita anterior.
    -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme') || 'dark';
        if (saved === 'light') {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body class="text-white flex flex-col min-h-screen">

  <!-- Burbujas glassmorphic animadas en el fondo (detrás de todo el contenido) -->
  <FloatingShapes client:load />

  <main class="flex-grow relative z-10">
    <slot />
  </main>

 <Footer client:load />


</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Work Sans', sans-serif;
    overflow-x: hidden;
  }
</style>
